    "@mui/icons-material": "^5.18.0",
    "@mui/material": "^5.18.0",
    "@tanstack/react-query": "^4.44.0",
    "@tanstack/react-query-devtools": "^4.44.0",
    "@types/react-window": "^1.8.7",
    "axios": "^1.21.1",
    "classnames": "^2.5.1",
    "d3": "^7.9.2",
    "lodash": "^4.18.1",
    "moment": "^2.31.0",
    "re-resizable": "^6.11.2",
    "react": "^18.3.1",
    "react-device-detect": "^2.2.3",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.92.0",
    "react-player": "^2.16.1",
    "react-router-dom": "^6.30.6",
    "react-use-websocket": "^4.13.0",
    "react-virtualized-auto-sizer": "^1.0.26",
    "react-window": "^1.8.11",
    "resize-observer-polyfill": "^1.5.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@storybook/addon-essentials": "^7.6.24",
    "@storybook/addon-interactions": "^7.6.24",
    "@storybook/addon-links": "^7.6.24",
    "@storybook/addon-onboarding": "^1.0.11",
    "@storybook/addon-styling": "^1.3.7",
    "@storybook/blocks": "^7.2.1",
    "@storybook/react": "^7.6.24",
    "@storybook/react-vite": "^7.6.24",
    "@storybook/testing-library": "^0.2.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^14.3.1",
    "@testing-library/user-event": "^14.6.13",
    "@types/d3": "^7.4.3",
    "@types/node": "^20.19.43",
    "@types/react": "^18.2.15",
    "@types/react-dom": "^18.2.7",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/coverage-v8": "^0.34.6",
    "chromatic": "^6.24.1",
    "eslint": "^8.45.0",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-react-refresh": "^0.5.8",
    "eslint-plugin-storybook": "^0.12.0",
    "husky": "^8.0.3",
    "jsdom": "^22.1.0",
    "lint-staged": "^15.5.2",
    "prettier": "^3.10.1",
    "sass": "^1.108.2",
    "storybook": "^7.6.24",
    "storybook-dark-mode": "^3.0.3",
    "typescript": "^5.9.3",
    "usehooks-ts": "^2.16.0",
    "vite": "^4.5.14",
    "vitest": "^0.34.6"
